# Copy to .env and fill in values. Never commit .env.
FINNHUB_API_KEY=your_finnhub_api_key_here

# AI is optional. Prefer Ops → Trader config, or set here as fallback.
# validate = Ollama/cloud reviews HIGH signals (recommended when Ollama is up).
AI_MODE=validate
# AI_MODE=off
# AI_MODE=full

# --- Local Ollama (default when LLM_BACKEND unset) ---
OLLAMA_HOST=http://host.docker.internal:11434
# Prefer general/instruct models for trading decisions (not coder models).
AI_MODEL=gemma4:latest

# --- Cheap cloud instead of Ollama (OpenAI-compatible) ---
# LLM_BACKEND=openai
# OPENAI_API_KEY=gsk_...
# OPENAI_BASE_URL=https://api.groq.com/openai/v1
# AI_MODEL=llama-3.1-8b-instant
# See MODELS.md for OpenRouter / DeepSeek examples.

# Multi-role bull/bear/risk debate for AI validate (1=on)
AI_MULTI_ROLE=1
# Soft SMA regime gate for *new* buys (SPY SMA200 / BTC SMA50). 0=off.
REGIME_GATE=1
# Soft RS entry gate: block new buys lagging SPY (stocks) / BTC (crypto) over RS_LOOKBACK sessions
RS_GATE=1
# RS_LOOKBACK=63
# Soft scan-list breadth gate (crypto A/D + stock leaders on our scan — not full universe)
BREADTH_GATE=1
# BREADTH_MIN_ADVANCE=0.40
# BREADTH_MIN_STOCK_LEADERS=1
# Champion entry filter from experiment_strategy (0=off until calm paper month).
# Prefer Ops toggle; this is the env fallback when trader_config.json is missing.
PROMOTE_EXPERIMENT_STRATEGY=0
# Paper fee schedule: revolut_standard (1 free/mo), revolut_plus (3), revolut_ultra (10), binance_like
FEE_PRESET=revolut_standard
# Full AI prompt/response dumps in logs (0=quiet one-liners, recommended overnight)
AI_VERBOSE=0
# Autoresearch local worker (optional — needs Ollama today)
# OLLAMA_AUTOSEARCH_MODEL=gemma4:latest
# OLLAMA_AUTOSEARCH_PUSH=0
# Net seconds between tick *starts* (work counts). Old idle-after default was 480.
# OLLAMA_AUTOSEARCH_INTERVAL_SEC=120
# 2h sprint: ./scripts/run_ollama_autoresearch_sprint.sh
# OLLAMA_AUTOSEARCH_SPRINT_SEC=7200
# Dense param grid (no Ollama): ./scripts/run_param_autoresearch_loop.sh
# AUTOSEARCH_PARAM_INTERVAL_SEC=5
# AUTOSEARCH_HOST_SCORE=1
# Night window (default 23:00–05:00 Europe/Berlin). Override TZ or hours if needed.
# OLLAMA_AUTOSEARCH_TZ=Europe/Berlin
# OLLAMA_AUTOSEARCH_NIGHT_START=23
# OLLAMA_AUTOSEARCH_NIGHT_END=5
# OLLAMA_AUTOSEARCH_FORCE=0

# Optional shared secret for OpenBB custom backend (X-API-KEY)
OPENBB_BACKEND_API_KEY=
